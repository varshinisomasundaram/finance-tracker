DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker"
JWT_SECRET="change-me-to-a-secure-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:5173"

# Optional — omit to disable caching and rate limiting via Redis
# REDIS_URL="redis://localhost:6379"

# Optional — SMTP for contact form emails
# If omitted, contact form submissions are printed to the server log instead of emailed.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-gmail@gmail.com"
# SMTP_PASS="your-app-password"        # Gmail: use an App Password, not your account password
# SMTP_FROM="FinanceTracker <no-reply@financetracker.app>"
# CONTACT_TO="hello@financetracker.app"  # inbox that receives contact form submissions
