generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  currency     String   @default("INR")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts          Account[]
  assets            Asset[]
  liabilities       Liability[]
  insurances        Insurance[]
  transactions      Transaction[]
  categories        Category[]
  goals             Goal[]
  budgets           Budget[]
  networthSnapshots NetWorthSnapshot[]
  refreshTokens     RefreshToken[]
  importSessions    ImportSession[]
  reviews           Review[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Accounts ────────────────────────────────────────────────────────────────

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CRYPTO
  CASH
  OTHER
}

model Account {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  name        String
  type        AccountType
  institution String?
  balance     Decimal     @default(0) @db.Decimal(15, 2)
  currency    String      @default("INR")
  color       String?
  isActive    Boolean     @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

// ─── Assets ──────────────────────────────────────────────────────────────────

enum AssetType {
  REAL_ESTATE       // Land, house
  VEHICLE           // Car, bike
  EQUITY            // Direct stocks / shares
  MUTUAL_FUND       // Indian equity MF (long term / short term / hold forever)
  RETIREMENT        // NPS, EPF
  PROVIDENT_FUND    // PPF, GPF
  GOVERNMENT_SCHEME // Sukanya Samriddhi, NSC, KVP, SSY
  SAVINGS           // FD, RD, savings account
  CASH              // Physical cash
  GOLD              // Physical gold, gold bond, gold ETF
  CRYPTO            // Cryptocurrency
  INSURANCE_POLICY  // LIC endowment / money-back (has maturity value)
  BUSINESS          // Business ownership / equity
  OTHER
}

enum InvestmentStrategy {
  LONG_TERM    // > 3 years
  SHORT_TERM   // < 1 year
  HOLD_FOREVER // Never sell (compounding)
}

model Asset {
  id                 String              @id @default(cuid())
  userId             String              @map("user_id")
  name               String
  type               AssetType
  value              Decimal             @db.Decimal(15, 2)
  purchasePrice      Decimal?            @map("purchase_price") @db.Decimal(15, 2)
  purchaseDate       DateTime?           @map("purchase_date")
  // Mutual fund / gold / equity extra fields
  investmentStrategy InvestmentStrategy? @map("investment_strategy")
  targetDate         DateTime?           @map("target_date")   // MF exit / maturity ETA
  quantity           Decimal?            @db.Decimal(18, 6)    // MF units / gold grams / shares
  currency           String              @default("INR")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])         // pie chart GROUP BY type
  @@index([userId, purchaseDate]) // time-series purchase history
  @@index([userId, targetDate])   // MF exit ETA timeline
  @@map("assets")
}

// ─── Liabilities ─────────────────────────────────────────────────────────────

enum LiabilityType {
  MORTGAGE         // House loan
  CAR_LOAN         // Car loan
  TWO_WHEELER_LOAN // Bike loan (Activa, Yamaha etc.)
  GOLD_LOAN        // Gold loan
  STUDENT_LOAN
  PERSONAL_LOAN
  INFORMAL_DEBT    // Credit from friends & family
  CREDIT_CARD
  MEDICAL
  OTHER
}

model Liability {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  name           String
  type           LiabilityType
  balance        Decimal       @db.Decimal(15, 2)
  originalAmount Decimal?      @map("original_amount") @db.Decimal(15, 2)
  interestRate   Decimal?      @map("interest_rate") @db.Decimal(5, 2)
  minimumPayment Decimal?      @map("minimum_payment") @db.Decimal(15, 2)
  dueDate        DateTime?     @map("due_date")
  currency       String        @default("INR")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type]) // bar chart GROUP BY type
  @@index([userId, dueDate])
  @@map("liabilities")
}

// ─── Insurance ───────────────────────────────────────────────────────────────

enum InsuranceType {
  TERM_LIFE            // Pure risk term insurance (no maturity value)
  HEALTH               // Health / mediclaim insurance
  VEHICLE_TWO_WHEELER  // Bike insurance (Activa, Yamaha etc.)
  VEHICLE_FOUR_WHEELER // Car insurance (Grandi10 etc.)
  ENDOWMENT            // LIC endowment / money-back (maturity payout)
  ULIP                 // Unit linked insurance plan
  HOME                 // Home / property insurance
  OTHER
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
  SINGLE_PREMIUM
}

enum InsuranceStatus {
  ACTIVE
  EXPIRED
  LAPSED
  CANCELLED
}

model Insurance {
  id                  String           @id @default(cuid())
  userId              String           @map("user_id")
  name                String
  type                InsuranceType
  provider            String           // LIC, Star Health, HDFC Ergo, etc.
  policyNumber        String?          @map("policy_number")
  premiumAmount       Decimal          @map("premium_amount") @db.Decimal(15, 2)
  premiumFrequency    PremiumFrequency @map("premium_frequency")
  sumInsured          Decimal          @map("sum_insured") @db.Decimal(15, 2)
  startDate           DateTime         @map("start_date")
  renewalDate         DateTime         @map("renewal_date")  // next due / renewal date
  status              InsuranceStatus  @default(ACTIVE)
  vehicleRegistration String?          @map("vehicle_registration") // for vehicle insurance
  nominees            String?          // comma-separated nominee names
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])        // pie chart by insurance type
  @@index([userId, status])      // filter active policies
  @@index([userId, renewalDate]) // renewal timeline / bar chart
  @@map("insurances")
}

// ─── Transactions ─────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id        String          @id @default(cuid())
  userId    String?         @map("user_id")
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  icon      String?
  isSystem  Boolean         @default(false) @map("is_system")
  createdAt DateTime        @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  accountId   String?         @map("account_id")
  categoryId  String?         @map("category_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  date        DateTime
  description String
  notes       String?
  tags        String[]
  isRecurring Boolean         @default(false) @map("is_recurring")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([userId, type, date]) // monthly income/expense summary charts
  @@map("transactions")
}

// ─── Goals ───────────────────────────────────────────────────────────────────

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum GoalType {
  SAVINGS
  DEBT_PAYOFF
  INVESTMENT
  EMERGENCY_FUND
  PURCHASE
  OTHER
}

model Goal {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  name          String
  type          GoalType
  targetAmount  Decimal    @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal    @default(0) @map("current_amount") @db.Decimal(15, 2)
  targetDate    DateTime?  @map("target_date")
  status        GoalStatus @default(ACTIVE)
  priority      Int        @default(0)
  color         String?
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("goals")
}

// ─── Budgets ──────────────────────────────────────────────────────────────────

enum BudgetPeriod {
  MONTHLY
  ANNUAL
}

model Budget {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  categoryId String?      @map("category_id")
  name       String
  amount     Decimal      @db.Decimal(15, 2)
  period     BudgetPeriod @default(MONTHLY)
  month      Int?
  year       Int?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, year, month]) // budget vs actual monthly chart
  @@map("budgets")
}

// ─── Net Worth ────────────────────────────────────────────────────────────────

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  totalAssets      Decimal  @map("total_assets") @db.Decimal(15, 2)
  totalLiabilities Decimal  @map("total_liabilities") @db.Decimal(15, 2)
  netWorth         Decimal  @map("net_worth") @db.Decimal(15, 2)
  snapshotDate     DateTime @default(now()) @map("snapshot_date")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, snapshotDate])
  @@map("networth_snapshots")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id              String   @id @default(cuid())
  name            String
  role            String
  rating          Int      // 1–5
  text            String
  isApproved      Boolean  @default(false) @map("is_approved")
  helpfulCount    Int      @default(0) @map("helpful_count")
  notHelpfulCount Int      @default(0) @map("not_helpful_count")
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isApproved])
  @@map("reviews")
}

// ─── Imports ──────────────────────────────────────────────────────────────────

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ImportSession {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  filename      String
  status        ImportStatus @default(PENDING)
  mappedColumns Json?        @map("mapped_columns")
  rowCount      Int          @default(0) @map("row_count")
  importedCount Int          @default(0) @map("imported_count")
  errors        Json?
  importedAt    DateTime?    @map("imported_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("import_sessions")
}
